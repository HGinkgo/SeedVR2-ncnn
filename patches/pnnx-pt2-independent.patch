+                check(target.size() >= 1 && target.size() <= 8 &&
+                      op->inputs[0]->shape.size() >= 1 && op->inputs[0]->shape.size() <= 8 && target == op->outputs[0]->shape &&
+                      target.size() == op->outputs[0]->shape.size(), "unsupported Tensor.reshape shape");
+                int64_t input_size = 1, output_size = 1;
+                for (int value : op->inputs[0]->shape)
+                {
+                    check(value > 0, "Tensor.reshape requires a fixed input size");
+                    input_size *= value;
+                }
+                for (int value : target)
+                {
+                    check(value > 0, "Tensor.reshape requires a fixed output size");
+                    output_size *= value;
+                }
+                check(input_size == output_size, "Tensor.reshape element count mismatch");
+            }
+            if (type == "Tensor.select")
+            {
+                check(op->params.size() == 2 && op->has_param("dim") && op->has_param("index"),
+                      "incomplete Tensor.select parameters");
+                const int dim = op->params.at("dim").i;
+                const int index = op->params.at("index").i;
+                check(op->inputs[0]->shape.size() >= 1 && op->inputs[0]->shape.size() <= 8 && op->outputs[0]->shape.size() >= 1 &&
+                      dim >= 0 && dim < (int)op->inputs[0]->shape.size() &&
+                      index >= 0 && index < op->inputs[0]->shape[dim], "unsupported Tensor.select shape or parameters");
+                std::vector<int> expected = op->inputs[0]->shape;
+                expected.erase(expected.begin() + dim);
+                check(expected == op->outputs[0]->shape, "Tensor.select shape mismatch");
+            }
+            if (type == "Tensor.permute")
+            {
+                check(op->params.size() == 1 && op->has_param("dims") && op->params.at("dims").type == 5,
+                      "incomplete Tensor.permute parameters");
+                const std::vector<int>& permutation = op->params.at("dims").ai;
+                check(permutation.size() == op->inputs[0]->shape.size() &&
+                      op->outputs[0]->shape.size() == permutation.size(), "Tensor.permute rank mismatch");
+                std::vector<int> expected(permutation.size());
+                std::vector<int> seen(permutation.size(), 0);
+                for (size_t i = 0; i < permutation.size(); i++)
+                {
+                    check(permutation[i] >= 0 && permutation[i] < (int)permutation.size() && !seen[permutation[i]], "invalid Tensor.permute permutation");
+                    seen[permutation[i]] = 1;
+                    expected[i] = op->inputs[0]->shape[permutation[i]];
+                }
+                check(expected == op->outputs[0]->shape, "Tensor.permute shape mismatch");
+            }
+            if (type == "torch.matmul")
+            {
+                check(op->params.empty() && op->inputs[0]->shape.size() >= 2 && op->inputs[1]->shape.size() >= 2,
+                      "invalid torch.matmul parameters or ranks");
+                const std::vector<int>& left = op->inputs[0]->shape;
+                const std::vector<int>& right = op->inputs[1]->shape;
+                check(left.back() == right[right.size() - 2], "torch.matmul contraction mismatch");
+                const size_t batch_rank = std::max(left.size(), right.size()) - 2;
+                std::vector<int> expected(batch_rank);
+                for (size_t axis = 1; axis <= batch_rank; axis++)
+                {
+                    const int ldim = axis <= left.size() - 2 ? left[left.size() - 2 - axis] : 1;
+                    const int rdim = axis <= right.size() - 2 ? right[right.size() - 2 - axis] : 1;
+                    check(ldim == rdim || ldim == 1 || rdim == 1, "torch.matmul batch mismatch");
+                    expected[batch_rank - axis] = std::max(ldim, rdim);
+                }
+                expected.push_back(left[left.size() - 2]);
+                expected.push_back(right.back());
+                check(expected == op->outputs[0]->shape, "torch.matmul output shape mismatch");
+            }
+            if (type == "F.scaled_dot_product_attention")
+            {
+                check(op->params.empty() && op->inputs[0]->shape.size() >= 3 &&
+                      op->inputs[0]->shape.size() <= 4 &&
+                      op->inputs[1]->shape.size() == op->inputs[0]->shape.size() &&
+                      op->inputs[2]->shape.size() == op->inputs[0]->shape.size(),
+                      "only fixed rank-3/4 unmasked SDPA is supported");
+                const std::vector<int>& query = op->inputs[0]->shape;
+                const std::vector<int>& key = op->inputs[1]->shape;
+                const std::vector<int>& value = op->inputs[2]->shape;
+                check(std::equal(query.begin(), query.end() - 2, key.begin()) &&
+                      std::equal(query.begin(), query.end() - 2, value.begin()) &&
+                      query.back() == key.back() && key[key.size() - 2] == value[value.size() - 2],
+                      "SDPA q/k/v shape mismatch");
+                std::vector<int> expected(query.begin(), query.end() - 2);
+                expected.push_back(query[query.size() - 2]);
+                expected.push_back(value.back());
+                check(op->outputs[0]->shape == expected,
+                      "SDPA output shape mismatch");
+            }
+            if (type == "pnnx.Input")
+            {
+                check(op->outputs[0]->shape.size() >= 1 && op->outputs[0]->shape.size() <= 5, "canonical PT2 input rank must be 1..5");
+                shapes.push_back(std::vector<int64_t>(op->outputs[0]->shape.begin(), op->outputs[0]->shape.end()));
+                check(sample_tokens > 0 && (shapes.back()[0] == -1 || shapes.back()[0] == sample_tokens), "missing/inconsistent input sample shape");
+                shapes.back()[0] = sample_tokens;
+                types.push_back("f32");
+                inputs++;
+            }
+            if (type == "pnnx.Output") outputs++;
+        }
+        while (std::getline(file, line)) check(line.empty(), "unexpected trailing IR content");
+        check((int)graph.operands.size() == operands && inputs && outputs, "IR operand/input/output count mismatch");
+        check(archive.get_names().size() == attributes.size(), "unexpected IR weight entries");
+        return 0;
+    }
+    catch (const std::exception& error)
+    {
+        fprintf(stderr, "canonical PT2 IR rejected: %s\n", error.what());
+        return -1;
+    }
+}
