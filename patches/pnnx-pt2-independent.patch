+# SPDX-License-Identifier: BSD-3-Clause
+# Copyright (c) 2026 SeedVR2-ncnn contributors
+
+"""Restricted ExportedProgram frontend; emits canonical PNNX IR, without tracing.
+
+Requires PyTorch only at conversion time. Supported: FP32 flat user inputs,
+rank-1..8 static intermediate tensors, rank-1..5 lifted parameters,
+aten.linear.default, aten.rms_norm.default, aten.silu.default,
+aten.alias.default, aten.slice.Tensor, aten.reshape.default,
+aten.select.int, aten.permute.default, aten.matmul.default,
+aten.scaled_dot_product_attention.default, and elementwise aten.mul.Tensor,
+aten.add.Tensor, or aten.div.Tensor with ordinary trailing-dimension
+broadcasting. User inputs are flat positional tensors with fixed rank; internal
+attention tensors are fixed-shape rank-3/4/5 values. A
+direct bounded symbolic token axis is preserved as -1. Native callers must
+enforce the exported constraints recorded in the sidecar JSON.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import re
+import sys
+import zipfile
+from pathlib import Path
+
+import torch
+
+
+class Unsupported(ValueError):
+    pass
+
+
+def require(condition, message):
+    if not condition:
+        raise Unsupported(message)
+
+
+def read_program(path):
+    program = torch.export.load(path)
+    args, kwargs = program.call_spec.in_spec.children()
+    require(args.type is tuple and kwargs.type is dict and kwargs.num_children == 0
+            and all(child.is_leaf() for child in args.children()),
+            'PT2 input structure: flat positional tensors required')
+    outputs = program.call_spec.out_spec
+    require(outputs.is_leaf() or (outputs.type in (tuple, list)
+            and all(child.is_leaf() for child in outputs.children())),
+            'PT2 output structure: tensor or flat tensor tuple/list required')
+    for spec in program.graph_signature.output_specs:
+        require(spec.kind.name == 'USER_OUTPUT', 'PT2 mutation/state outputs are unsupported')
+        require(isinstance(spec.arg, torch.export.graph_signature.TensorArgument),
+                'PT2 non-tensor outputs are unsupported')
+    return program
+
+
+def lower(path: Path, param: Path, weights: Path, input_shapes=None):
+    program = read_program(path)
+    lines, blobs, lifted, tensors, used_weights = [], {}, {}, {}, set()
+    emitted_attributes = set()
+    aliases = {}
+    tuple_values = {}
+    signature, symbol_values = [], {}
+    constraints = {}
+    for symbol, bounds in program.range_constraints.items():
+        require(bool(symbol.is_Symbol), f'PT2 derived dynamic constraint unsupported: {symbol}')
+        # PyTorch 2.11 represents an unbounded upper limit as IntInfinity;
+        # its inherited SymPy is_finite property can incorrectly report True.
+        require(bounds.lower.is_Integer is True and bounds.upper.is_Integer is True,
+                f'PT2 dynamic range must be finite: {symbol} {bounds}')
+        try:
+            low, high = int(bounds.lower), int(bounds.upper)
+        except (TypeError, ValueError, OverflowError) as exc:
+            raise Unsupported(f'PT2 dynamic range must be finite: {symbol} {bounds}') from exc
+        require(1 <= low <= high <= 2147483647, f'PT2 dynamic range unsupported: {symbol} {bounds}')
+        constraints[str(symbol)] = [low, high]
+
+    # ExportedProgram can retain pure stochastic helper branches even when a
+    # wrapper selects a deterministic posterior mode.  Lower only the graph
+    # reachable from user outputs; dead branches cannot affect the native
+    # result and should not widen the supported operator surface.
+    live = set()
+    def mark_live(value):
+        if isinstance(value, torch.fx.Node) and value not in live:
+            live.add(value)
+            for argument in value.args:
+                mark_live(argument)
+            for argument in value.kwargs.values():
+                mark_live(argument)
+        elif isinstance(value, (tuple, list)):
+            for item in value:
+                mark_live(item)
+        elif isinstance(value, dict):
+            for item in value.values():
+                mark_live(item)
+    output_nodes = [node for node in program.graph.nodes if node.op == 'output']
+    require(len(output_nodes) == 1, 'PT2 graph must have exactly one output node')
+    mark_live(output_nodes[0])
+    # Preserve the exported user-input signature even when a model carries an
+    # unused input (for example an optional embedding branch).  Dead internal
+    # helpers are pruned, while callers still receive the declared inputs.
+    live.update(node for node in program.graph.nodes if node.op == 'placeholder')
+
+    def shape(node):
+        value = node.meta.get('val')
+        require(isinstance(value, torch.Tensor) and value.dtype in (torch.float32, torch.int32, torch.int64)
+                and 1 <= value.ndim <= 8,
+                f'PT2 node {node.name}: only rank-1..8 float32 or integer tensors are supported')
+        if value.ndim >= 3:
+            require(all(isinstance(size, int) for size in value.shape),
+                    f'PT2 node {node.name}: rank-3..5 tensors must have static dimensions')
+        result = []
+        for axis, size in enumerate(value.shape):
+            if isinstance(size, int):
+                require(0 <= size <= 2147483647, f'PT2 invalid dimension at {node.name}[{axis}]')
+                result.append(size)
+            else:
+                expr = size.node.expr
+                require(axis == 0 and bool(expr.is_Symbol) and str(expr) in constraints,
+                        f'PT2 unsupported symbolic dimension at {node.name}[{axis}]: {expr}')
+                result.append(str(expr))
+        return result
+
+    def shape_token(name, dims):
+        return f'#{name}=(' + ','.join(str(d) if isinstance(d, int) else '-1' for d in dims) + ')f32'
+
+    def emit(kind, name, inputs, output, dims, params=()):
+        require(re.fullmatch(r'[A-Za-z_][A-Za-z_0-9]*', name), f'PT2 invalid node name: {name}')
+        operands = inputs + ([output] if output else [])
+        fields = [kind, name, str(len(inputs)), str(int(output is not None)), *operands, *params]
+        if output:
+            blobs[output] = dims
+            fields.append(shape_token(output, dims))
+        lines.append(' '.join(fields))
+
+    def emit_attribute(node):
+        """Materialize a lifted vector/matrix as a canonical PNNX attribute."""
+        require(node.name in lifted, f'PT2 constant {getattr(node, "name", None)} is not lifted')
+        target, value = lifted[node.name]
+        require(1 <= value.ndim <= 5,
+                f'PT2 constant {target}: only rank-1..5 parameters are supported')
+        if node.name not in emitted_attributes:
+            attribute_name = 'constant_' + node.name
+            dims = [int(size) for size in value.shape]
+            tensors[attribute_name + '.data'] = value
+            dtype = 'f32' if value.dtype == torch.float32 else ('i32' if value.dtype == torch.int32 else 'i64')
+            emit('pnnx.Attribute', attribute_name, [], node.name, dims,
+                 ['@data=(' + ','.join(str(size) for size in dims) + ')' + dtype])
+            emitted_attributes.add(node.name)
+        used_weights.add(node.name)
+        return node.name, blobs[node.name]
+
+    def operand(node):
+        require(isinstance(node, torch.fx.Node), 'PT2 elementwise operands must be tensors')
+        name = resolve(node.name)
+        if name in blobs:
+            return name, blobs[name]
+        return emit_attribute(node)
+
+    def resolve(name):
+        while name in aliases:
+            name = aliases[name]
+        return name
+
+    def broadcastable(first, second, output, node_name):
+        require(1 <= len(first) <= 8 and 1 <= len(second) <= 8 and 1 <= len(output) <= 8,
+                f'PT2 elementwise {node_name}: tensor rank must be between 1 and 8')
+        require(len(output) == max(len(first), len(second)),
+                f'PT2 elementwise {node_name}: output rank is not a broadcast rank')
+        result = []
+        for axis in range(1, len(output) + 1):
+            left = first[-axis] if axis <= len(first) else 1
+            right = second[-axis] if axis <= len(second) else 1
+            if left == right:
+                result.append(left)
+            elif left == 1:
+                result.append(right)
+            elif right == 1:
+                result.append(left)
+            else:
+                raise Unsupported(
+                    f'PT2 elementwise {node_name}: incompatible dimensions {left} and {right}')
+        require(list(reversed(result)) == output,
+                f'PT2 elementwise {node_name}: output shape is not the broadcast result')
+
+    specs = {s.arg.name: s for s in program.graph_signature.input_specs}
+    examples = program.example_inputs[0]
+    require(input_shapes is None or len(input_shapes) == len(examples), 'PT2 input shape count mismatch')
+    input_index = 0
+    for node in program.graph.nodes:
+        if node.op != 'output' and node not in live:
+            continue
+        if node.op == 'placeholder':
+            spec = specs[node.name]
+            if spec.kind.name in ('PARAMETER', 'BUFFER', 'CONSTANT_TENSOR'):
+                mapping = program.constants if spec.kind.name == 'CONSTANT_TENSOR' else program.state_dict
+                tensor = mapping[spec.target]
+                require(isinstance(tensor, torch.Tensor) and tensor.layout == torch.strided,
+                        f'PT2 weight {spec.target}: only dense strided tensors supported')
+                if tensor.dtype != torch.float32:
+                    require(spec.kind.name == 'BUFFER' and tensor.dtype in (torch.int32, torch.int64),
+                            f'PT2 weight {spec.target}: only dense float32 supported (integer buffers are index constants)')
+                lifted[node.name] = (spec.target, tensor.detach().cpu().contiguous())
+            else:
+                require(spec.kind.name == 'USER_INPUT' and isinstance(spec.arg,
+                        torch.export.graph_signature.TensorArgument), 'PT2 user input must be a tensor')
+                dims = shape(node)
+                concrete = list(input_shapes[input_index] if input_shapes is not None else examples[input_index].shape)
+                require(len(concrete) == len(dims) and 1 <= len(dims) <= 5,
+                        f'PT2 input {node.name}: user inputs must be rank 1..5')
+                for axis, (expected, actual) in enumerate(zip(dims, concrete)):
+                    require(isinstance(actual, int) and actual > 0, 'PT2 input dimensions must be positive integers')
+                    if isinstance(expected, int):
+                        require(actual == expected, f'PT2 input {node.name}[{axis}]: expected {expected}, got {actual}')
+                    else:
+                        low, high = constraints[expected]
+                        require(low <= actual <= high, f'PT2 input {node.name}[{axis}]={actual} violates {expected} range [{low},{high}]')
+                        require(expected not in symbol_values or symbol_values[expected] == actual,
+                                f'PT2 shared symbol {expected}: conflicting input dimension {actual}')
+                        symbol_values[expected] = actual
+                signature.append({'name': node.name, 'shape': dims, 'example_shape': concrete})
+                emit('pnnx.Input', 'input_' + str(input_index), [], node.name, dims,
+                     [f'sample_tokens={concrete[0]}'])
+                input_index += 1
+        elif node.op == 'call_function':
+            target = str(node.target)
+            if target == 'aten._assert_tensor_metadata.default':
+                require(node.args and isinstance(node.args[0], torch.fx.Node),
+                        f'PT2 metadata assertion {node.name}: expected tensor input')
+                require(set(node.kwargs) <= {'dtype', 'device', 'layout'},
+                        f'PT2 metadata assertion {node.name}: unsupported checks {sorted(node.kwargs)}')
+                device = node.kwargs.get('device', torch.device('cpu'))
+                require(node.kwargs.get('dtype', torch.float32) == torch.float32
+                        and node.kwargs.get('layout', torch.strided) == torch.strided
+                        and str(device).split(':', 1)[0] in ('cpu', 'cuda'),
+                        f'PT2 metadata assertion {node.name}: only dense float32 CPU/CUDA checks are supported')
+                # Export inserts these guards for shape/stride/device checks. They
+                # have no tensor result and are safe only when the exported graph
+                # already carries a statically validated tensor value.
+                continue
+            if target in ('<built-in function getitem>', 'operator.getitem', 'builtins.getitem'):
+                require(len(node.args) == 2 and isinstance(node.args[0], torch.fx.Node)
+                        and isinstance(node.args[1], int),
+                        f'PT2 getitem {node.name}: fixed tuple index required')
+                source = tuple_values.get(node.args[0].name)
+                require(source is not None, f'PT2 getitem {node.name}: source is not a lowered tuple')
+                base, axis, count, *kind = source
+                index = node.args[1]
+                require(0 <= index < count and base in blobs,
+                        f'PT2 getitem {node.name}: tuple index out of range')
+                base_dims = blobs[base]
+                if kind == ['chunk']:
+                    require(base_dims[axis] % count == 0,
+                            f'PT2 chunk {node.name}: only evenly sized chunks are supported')
+                    chunk_size = base_dims[axis] // count
+                    dims = list(base_dims)
+                    dims[axis] = chunk_size
+                    emit('Tensor.slice', node.name, [base], node.name, dims,
+                         [f'dim={axis}', f'start={index * chunk_size}',
+                          f'end={(index + 1) * chunk_size}', 'step=1'])
+                else:
+                    dims = base_dims[:axis] + base_dims[axis + 1:]
+                    emit('Tensor.select', node.name, [base], node.name, dims,
+                         [f'dim={axis}', f'index={index}'])
+                continue
+            require(not node.kwargs or target == 'aten.to.dtype_layout',
+                    (f'PT2 SDPA {node.name}: mask/dropout/causal/scale/GQA arguments unsupported'
+                     if target == 'aten.scaled_dot_product_attention.default' else
+                     f'PT2 node {node.name}: keyword operator arguments unsupported'))
+            require(target in ('aten.linear.default', 'aten.rms_norm.default',
+                               'aten.silu.default', 'aten.alias.default', 'aten.slice.Tensor',
+                               'aten.reshape.default', 'aten.select.int',
+                               'aten.permute.default', 'aten.matmul.default',
+                               'aten.scaled_dot_product_attention.default',
+                               'aten.mul.Tensor', 'aten.add.Tensor', 'aten.sub.Tensor', 'aten.div.Tensor', 'aten.to.dtype',
+                               'aten.to.dtype_layout', 'aten.dropout.default', 'aten.tile.default',
+                               'aten.conv3d.default', 'aten.group_norm.default', 'aten.view.default',
+                               'aten.squeeze.dim',
+                               'aten.pow.Tensor_Scalar', 'aten.mean.dim', 'aten.rsqrt.default',
+                               'aten.transpose.int', 'aten.unsqueeze.default', 'aten.repeat.default', 'aten.unbind.int', 'aten.chunk.default', 'aten.stack.default', 'aten.cat.default', 'aten.index_select.default', 'aten.neg.default', 'aten.reshape_as.default', 'aten.cos.default', 'aten.sin.default', 'aten.softmax.int', 'aten.pad.default', 'aten.clamp.default', 'aten.exp.default'),
+                    f'PT2 unsupported operator at {node.name}: {target}')
+            require(node.args and (isinstance(node.args[0], torch.fx.Node)
+                    or (target in ('aten.stack.default', 'aten.cat.default') and isinstance(node.args[0], (tuple, list)))),
+                    f'PT2 node {node.name}: expected tensor input')
+            if target in ('aten.stack.default', 'aten.cat.default'):
+                first = None
+            else:
+                first = resolve(node.args[0].name)
+            if first not in blobs and isinstance(node.args[0], torch.fx.Node):
+                source_node = node.args[0]
+                if source_node.name in lifted:
+                    emit_attribute(source_node)
+                    first = source_node.name
+            if target == 'aten.unbind.int':
+                require(first in blobs and len(node.args) == 2 and isinstance(node.args[1], int),
+                        f'PT2 unbind {node.name}: fixed axis required')
+                axis = node.args[1] % len(blobs[first])
+                count = blobs[first][axis]
+                require(count > 0, f'PT2 unbind {node.name}: invalid axis')
+                tuple_values[node.name] = (first, axis, count)
+                continue
+            if target == 'aten.chunk.default':
+                require(first in blobs and len(node.args) == 3 and isinstance(node.args[1], int)
+                        and isinstance(node.args[2], int) and node.args[1] > 0,
+                        f'PT2 chunk {node.name}: fixed positive chunk count and axis are required')
+                axis = node.args[2] % len(blobs[first])
+                count = node.args[1]
+                require(blobs[first][axis] % count == 0,
+                        f'PT2 chunk {node.name}: only evenly sized chunks are supported')
+                values = node.meta.get('val')
+                require(isinstance(values, tuple) and len(values) == count
+                        and all(isinstance(value, torch.Tensor) for value in values),
+                        f'PT2 chunk {node.name}: tensor tuple metadata is required')
+                chunk_dims = list(blobs[first])
+                chunk_dims[axis] //= count
+                require(all(list(value.shape) == chunk_dims for value in values),
+                        f'PT2 chunk {node.name}: output shape mismatch')
+                tuple_values[node.name] = (first, axis, count, 'chunk')
+                continue
+            dims = shape(node)
+            if target == 'aten.pad.default':
+                require(first in blobs and len(node.args) in (2, 3, 4),
+                        f'PT2 pad {node.name}: invalid signature')
+                padding = node.args[1]
+                mode = node.args[2] if len(node.args) >= 3 else 'constant'
+                value = node.args[3] if len(node.args) >= 4 else 0.0
+                require(isinstance(padding, (tuple, list)) and len(padding) > 0
+                        and len(padding) % 2 == 0 and len(padding) <= 2 * len(blobs[first])
+                        and all(isinstance(item, int) and item >= 0 for item in padding),
+                        f'PT2 pad {node.name}: fixed non-negative padding is required')
+                require(mode == 'constant' and isinstance(value, (int, float)),
+                        f'PT2 pad {node.name}: only constant numeric padding is supported')
+                pad_axes = len(padding) // 2
+                expected = list(blobs[first])
+                for offset in range(pad_axes):
+                    axis = len(expected) - 1 - offset
+                    expected[axis] += padding[2 * offset] + padding[2 * offset + 1]
+                require(dims == expected, f'PT2 pad {node.name}: output shape mismatch')
+                emit('F.pad', node.name, [first], node.name, dims,
+                     ['pad=(' + ','.join(str(item) for item in padding) + ')',
+                      'mode=constant', f'value={float(value):.9g}'])
+            elif target == 'aten.clamp.default':
+                require(first in blobs and len(node.args) == 3
+                        and all(isinstance(value, (int, float)) for value in node.args[1:]),
+                        f'PT2 clamp {node.name}: fixed numeric min and max are required')
+                require(dims == blobs[first] and float(node.args[1]) <= float(node.args[2]),
+                        f'PT2 clamp {node.name}: shape or bounds are invalid')
+                emit('torch.clamp', node.name, [first], node.name, dims,
+                     [f'min={float(node.args[1]):.9g}', f'max={float(node.args[2]):.9g}'])
+            elif target == 'aten.exp.default':
+                require(first in blobs and len(node.args) == 1 and dims == blobs[first],
+                        f'PT2 exp {node.name}: shape/signature mismatch')
+                emit('pnnx.Expression', node.name, [first], node.name, dims, ['expr=exp(@0)'])
+            elif target == 'aten.to.dtype_layout':
+                require(first in blobs and len(node.args) == 1 and dims == blobs[first],
+                        f'PT2 dtype/layout cast {node.name}: shape/signature mismatch')
+                require(node.kwargs.get('dtype', torch.float32) == torch.float32
+                        and node.kwargs.get('layout', torch.strided) == torch.strided,
+                        f'PT2 dtype/layout cast {node.name}: only dense FP32 casts are supported')
+                aliases[node.name] = first
+            elif target == 'aten.dropout.default':
+                require(first in blobs and len(node.args) == 3 and dims == blobs[first]
+                        and isinstance(node.args[1], (int, float)) and float(node.args[1]) == 0.0
+                        and node.args[2] is False,
+                        f'PT2 dropout {node.name}: only inference dropout(p=0) is supported')
+                aliases[node.name] = first
+            elif target == 'aten.alias.default':
+                require(len(node.args) == 1 and first in blobs and dims == blobs[first],
+                        f'PT2 alias {node.name}: shape/signature mismatch')
+                aliases[node.name] = first
+            elif target == 'aten.to.dtype':
+                require(first in blobs and len(node.args) >= 2,
+                        f'PT2 cast {node.name}: invalid signature')
+                dtype = node.args[1]
+                require(dtype == torch.float32 and dims == blobs[first],
+                        f'PT2 cast {node.name}: only FP32-preserving casts are supported')
+                aliases[node.name] = first
+            elif target == 'aten.view.default':
+                require(first in blobs and len(node.args) == 2,
+                        f'PT2 view {node.name}: invalid signature')
+                requested = node.args[1]
+                require(isinstance(requested, (tuple, list)) and 1 <= len(requested) <= 8
+                        and all(isinstance(value, int) and value != 0 for value in requested),
+                        f'PT2 view {node.name}: only fixed positive shapes are supported')
+                requested = list(requested)
+                require(sum(item == -1 for item in requested) <= 1,
+                        f'PT2 view {node.name}: at most one inferred dimension is supported')
+                if -1 in requested:
+                    total = 1
+                    for item in blobs[first]:
+                        require(isinstance(item, int), f'PT2 view {node.name}: symbolic input size is unsupported')
+                        total *= item
+                    known = 1
+                    for item in requested:
+                        if item != -1:
+                            known *= item
+                    require(known > 0 and total % known == 0,
+                            f'PT2 view {node.name}: inferred dimension is not integral')
+                    requested[requested.index(-1)] = total // known
+                require(dims == requested and 1 <= len(dims) <= 8,
+                        f'PT2 view {node.name}: output shape mismatch')
+                in_size = 1
+                for item in blobs[first]:
+                    require(isinstance(item, int), f'PT2 view {node.name}: symbolic input size is unsupported')
+                    in_size *= item
+                out_size = 1
+                for item in dims:
+                    out_size *= item
+                require(in_size == out_size, f'PT2 view {node.name}: element count mismatch')
+                emit('Tensor.reshape', node.name, [first], node.name, dims,
+                     ['shape=(' + ','.join(str(value) for value in dims) + ')'])
+            elif target == 'aten.squeeze.dim':
+                require(first in blobs and len(node.args) == 2 and isinstance(node.args[1], int),
+                        f'PT2 squeeze {node.name}: fixed axis required')
+                axis = node.args[1] % len(blobs[first])
+                require(blobs[first][axis] == 1 and dims == blobs[first][:axis] + blobs[first][axis + 1:],
+                        f'PT2 squeeze {node.name}: only singleton axes can be removed')
+                emit('Tensor.reshape', node.name, [first], node.name, dims,
+                     ['shape=(' + ','.join(str(value) for value in dims) + ')'])
+            elif target == 'aten.tile.default':
+                require(first in blobs and len(node.args) == 2,
+                        f'PT2 tile {node.name}: invalid signature')
+                repeats = node.args[1]
+                require(isinstance(repeats, (tuple, list)) and len(repeats) == len(blobs[first])
+                        and all(isinstance(value, int) and value > 0 for value in repeats),
+                        f'PT2 tile {node.name}: fixed positive repeats required')
+                expected = [size * repeat for size, repeat in zip(blobs[first], repeats)]
+                require(dims == expected, f'PT2 tile {node.name}: output shape mismatch')
+                emit('Tensor.repeat', node.name, [first], node.name, dims,
+                     ['sizes=(' + ','.join(str(value) for value in repeats) + ')'])
+            elif target == 'aten.conv3d.default':
+                require(first in blobs and len(blobs[first]) == 5,
+                        f'PT2 Conv3d {node.name}: expected rank-5 activation input')
+                require(3 <= len(node.args) <= 8,
+                        f'PT2 Conv3d {node.name}: unsupported argument count')
+                weight_node = node.args[1]
+                require(isinstance(weight_node, torch.fx.Node) and weight_node.name in lifted,
+                        f'PT2 Conv3d {node.name}: weight must be a lifted constant')
+                _, weight = lifted[weight_node.name]
+                require(weight.ndim == 5, f'PT2 Conv3d {node.name}: invalid weight rank')
+
+                def triplet(value, label, default):
+                    if value is None:
+                        return list(default)
+                    require(isinstance(value, (tuple, list)) and len(value) == 3
+                            and all(isinstance(item, int) and item > 0 for item in value),
+                            f'PT2 Conv3d {node.name}: fixed {label} required')
