+namespace {
+void check(bool ok, const std::string& message)
+{
+    if (!ok) throw std::runtime_error(message);
+}
+int integer(const std::string& text)
+{
+    char* end = 0;
+    long value = strtol(text.c_str(), &end, 10);
+    check(!text.empty() && *end == 0 && value >= -1 && value <= 2147483647, "invalid integer: " + text);
+    return (int)value;
+}
+std::vector<int> shape(const std::string& text, bool weight)
+{
+    check(text.size() >= 6 && text[0] == '(' &&
+          (text.substr(text.size() - 4) == ")f32" || text.substr(text.size() - 4) == ")i32" || text.substr(text.size() - 4) == ")i64"),
+          "expected typed shape: " + text);
+    std::istringstream stream(text.substr(1, text.size() - 5));
+    std::string item;
+    std::vector<int> dims;
+    while (std::getline(stream, item, ','))
+    {
+        int value = integer(item);
+        check(value >= 0 || (!weight && value == -1 && dims.empty()), "unsupported dimension: " + item);
+        dims.push_back(value);
+    }
+    check(dims.size() >= 1 && dims.size() <= 8, "unsupported tensor rank: " + text);
+    if (dims.size() > 2)
+        for (int dim : dims) check(dim >= 0, "rank-3..8 tensors must be static");
+    return dims;
+}
+}
+
+int load_pnnx_ir(const std::string& path, pnnx::Graph& graph, std::vector<std::vector<int64_t> >& shapes, std::vector<std::string>& types)
