+                require(len(node.args) == 2, f'PT2 elementwise {node.name}: expected two tensor operands')
+                def scalar_operand(value):
+                    if isinstance(value, (int, float)):
+                        return value, []
+                    return operand(value)
+                first, first_dims = scalar_operand(node.args[0])
+                second, second_dims = scalar_operand(node.args[1])
+                if not first_dims or not second_dims:
+                    tensor, tensor_dims = (second, second_dims) if second_dims else (first, first_dims)
+                    scalar = first if not first_dims else second
+                    require(isinstance(scalar, (int, float)) and tensor in blobs,
+                            f'PT2 elementwise {node.name}: unsupported scalar operand')
+                    expression = {'aten.mul.Tensor': 'mul', 'aten.add.Tensor': 'add', 'aten.sub.Tensor': 'sub',
+                                  'aten.div.Tensor': 'div'}[target]
+                    emit('pnnx.Expression', node.name, [tensor], node.name, dims,
+                         [f'expr={expression}(@0,{float(scalar):.9g})'])
+                    continue
+                broadcastable(first_dims, second_dims, dims, node.name)
+                expression = {'aten.mul.Tensor': 'mul', 'aten.add.Tensor': 'add', 'aten.sub.Tensor': 'sub',
+                              'aten.div.Tensor': 'div'}[target]
+                emit('pnnx.Expression', node.name, [first, second], node.name, dims,
+                     [f'expr={expression}(@0,@1)'])
+        elif node.op == 'output':
+            require(len(node.args) == 1 and isinstance(node.args[0], (tuple, list)), 'PT2 malformed outputs')
+            for index, output in enumerate(node.args[0]):
+                require(isinstance(output, torch.fx.Node) and resolve(output.name) in blobs, 'PT2 output must be an activation tensor')
+                emit('pnnx.Output', 'output_' + str(index), [resolve(output.name)], None, None)
+        else:
+            raise Unsupported(f'PT2 unsupported node {node.name}: {node.op}')
+    require(input_shapes is None or len(input_shapes) == input_index, 'PT2 input shape count mismatch')
+    unused = set(lifted) - used_weights
+    require(all(name.startswith('b_attn_') or name.startswith('p_vae_encoder_') for name in unused),
+            'PT2 unused/non-linear lifted state unsupported: ' + str(unused))
+    for name in sorted(unused):
+        if name.startswith('b_attn_'):
+            emit_attribute(next(node for node in program.graph.nodes
+                                if node.op == 'placeholder' and node.name == name))
+    require(input_index > 0 and any(line.startswith('pnnx.Output ') for line in lines), 'PT2 missing user inputs/outputs')
+    record = {'frontend': 'seedvr2-restricted-pt2-v5', 'pytorch': torch.__version__,
+              'pt2_sha256': hashlib.sha256(path.read_bytes()).hexdigest(),
+              'inputs': signature, 'outputs': [s.arg.name for s in program.graph_signature.output_specs],
+              'range_constraints': constraints, 'runtime_guards': False,
+              'weights': {key: {'target': target, 'shape': list(value.shape),
+                  'sha256': hashlib.sha256(value.numpy().tobytes()).hexdigest()}
+                  for key, (target, value) in lifted.items()},
+              'operators': [str(n.target) for n in program.graph.nodes if n.op == 'call_function']}
+    # Do not publish any IR until the entire program has passed validation.
+    param.parent.mkdir(parents=True, exist_ok=True)
+    weights.parent.mkdir(parents=True, exist_ok=True)
+    with zipfile.ZipFile(weights, 'w', compression=zipfile.ZIP_STORED) as archive:
+        for name, value in tensors.items():
+            archive.writestr(name, value.numpy().tobytes())
+    param.write_text('7767517\n' + f'{len(lines)} {len(blobs)}\n' + '\n'.join(lines) + '\n')
+    param.with_suffix('.json').write_text(json.dumps(record, indent=2, sort_keys=True) + '\n')
+    return record
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('pt2', type=Path)
+    parser.add_argument('--param', required=True, type=Path)
+    parser.add_argument('--bin', required=True, type=Path)
+    parser.add_argument('--input-shapes', help='JSON list of concrete shapes to validate; graph stays dynamic')
+    args = parser.parse_args()
+    try:
+        print(json.dumps(lower(args.pt2, args.param, args.bin,
+                               json.loads(args.input_shapes) if args.input_shapes else None), indent=2))
+    except (Unsupported, OSError) as exc:
+        sys.exit(str(exc))
+
+
+if __name__ == '__main__':
+    main()
