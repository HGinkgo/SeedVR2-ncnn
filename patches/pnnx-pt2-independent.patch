diff --git a/tools/pnnx/tests/test_pt2_independent.py b/tools/pnnx/tests/test_pt2_independent.py
new file mode 100644
index 0000000..2766915
--- /dev/null
+++ b/tools/pnnx/tests/test_pt2_independent.py
@@ -0,0 +1,360 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# Copyright (c) 2026 SeedVR2-ncnn contributors
+"""Independent PT2 frontend contract and canonical-IR lowering regression."""
+import importlib.util
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+import zipfile
+
+import torch
+
+source = Path(__file__).resolve().parents[1]
+spec = importlib.util.spec_from_file_location('pt2_frontend', source / 'python/pt2_to_pnnx.py')
+frontend = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(frontend)
+pnnx = Path('../src/pnnx').resolve()
+
+
+class Model(torch.nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.gate = torch.nn.Linear(8, 16)
+        self.value = torch.nn.Linear(8, 16, bias=False)
+        self.out = torch.nn.Linear(16, 8)
+
+    def forward(self, x):
+        return self.out(torch.nn.functional.silu(self.gate(x)) * self.value(x))
+
+
+class ResidualModel(torch.nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.norm = torch.nn.RMSNorm(8, eps=1e-5, elementwise_affine=False)
+        self.gate = torch.nn.Linear(8, 16)
+        self.value = torch.nn.Linear(8, 16, bias=False)
+        self.out = torch.nn.Linear(16, 8)
+
+    def forward(self, x):
+        normalized = self.norm(x)
+        branch = self.out(torch.nn.functional.silu(self.gate(normalized)) * self.value(normalized))
+        return x + branch
+
+
+class AffineNormModel(torch.nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.norm = torch.nn.RMSNorm(8, eps=1e-5)
+
+    def forward(self, x):
+        return self.norm(x)
+
+
+class AdaModel(torch.nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.attn_shift = torch.nn.Parameter(torch.zeros(8))
+        self.attn_scale = torch.nn.Parameter(torch.ones(8))
+
+    def forward(self, x, modulation_shift, modulation_scale):
+        scale = modulation_scale + self.attn_scale
+        shift = modulation_shift + self.attn_shift
+        return x * scale + shift
+
+
+class AdaEmbeddingModel(torch.nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.attn_shift = torch.nn.Parameter(torch.zeros(8))
+        self.attn_scale = torch.nn.Parameter(torch.ones(8))
+
+    def forward(self, x, embedding):
+        modulation = embedding.reshape(8, 6)[:, :3]
+        shift = modulation.select(1, 0)
+        scale = modulation.select(1, 1)
+        return x * (scale + self.attn_scale) + (shift + self.attn_shift)
+
+
+class TensorUtilityModel(torch.nn.Module):
+    """Small graph covering utility ops used by the fixed VAE encoder export."""
+
+    def forward(self, x):
+        # Upstream posterior graphs may retain random helper nodes even when
+        # the selected output is deterministic; dead values must be pruned.
+        _dead_noise = torch.randn_like(x)
+        padded = torch.nn.functional.pad(x, (1, 1, 0, 0), value=0.0)
+        left, right = padded.chunk(2, dim=1)
+        return torch.exp(torch.clamp(left - right, min=-1.0, max=1.0))
+
+
+class DynamicSpatialModel(torch.nn.Module):
+    """A rank-3 dynamic probe kept as an explicit frontend boundary."""
+
+    def forward(self, x):
+        return torch.nn.functional.silu(x)
+
+
+class OutputNormModel(torch.nn.Module):
+    """The explicit RMS normalization used by the DiT output projection."""
+
+    def forward(self, x):
+        return x * torch.rsqrt(x.pow(2).mean(dim=-1, keepdim=True) + 1e-5)
+
+
+class AttentionModel(torch.nn.Module):
+    def __init__(self, *, boundary=False, mode='plain'):
+        super().__init__()
+        self.qkv = torch.nn.Linear(8, 24, bias=False)
+        self.qnorm = torch.nn.RMSNorm(4, eps=1e-5)
+        self.knorm = torch.nn.RMSNorm(4, eps=1e-5)
+        self.out = torch.nn.Linear(8, 8)
+        # A nontrivial fixed rotation exercises lifted buffers and batched matmul.
+        self.register_buffer('rotation', torch.linalg.qr(torch.randn(7, 4, 4)).Q)
+        self.boundary, self.mode = boundary, mode
+        if boundary:
+            self.norm = torch.nn.RMSNorm(8, eps=1e-5, elementwise_affine=False)
+            self.shift = torch.nn.Parameter(torch.randn(8))
+            self.scale = torch.nn.Parameter(torch.randn(8))
+            self.gate = torch.nn.Parameter(torch.randn(8))
+
+    def forward(self, x, embedding):
+        hidden = x
+        if self.boundary:
+            modulation = embedding.reshape(8, 6)[:, :3]
+            shift, scale, gate = (modulation.select(1, i) for i in range(3))
+            hidden = self.norm(x) * (scale + self.scale) + (shift + self.shift)
+        qkv = self.qkv(hidden).reshape(7, 3, 2, 4)
+        q = (self.qnorm(qkv.select(1, 0)) @ self.rotation).permute(1, 0, 2)
+        k = (self.knorm(qkv.select(1, 1)) @ self.rotation).permute(1, 0, 2)
+        v = qkv.select(1, 2).permute(1, 0, 2)
+        kwargs = {}
+        if self.mode == 'causal':
+            kwargs['is_causal'] = True
+        elif self.mode == 'mask':
+            kwargs['attn_mask'] = x[:, :7]
+        elif self.mode == 'dropout':
+            kwargs['dropout_p'] = 0.1
+        elif self.mode == 'scale':
+            kwargs['scale'] = 0.25
+        elif self.mode == 'gqa':
+            kwargs['enable_gqa'] = True
+        result = torch.nn.functional.scaled_dot_product_attention(q, k, v, **kwargs)
+        result = self.out(result.permute(1, 0, 2).reshape(7, 8))
+        return x + result * (gate + self.gate) if self.boundary else result
+
+
+def reject(operation, message):
+    try:
+        operation()
+    except ValueError as error:
+        assert message in str(error), str(error)
+    else:
+        raise AssertionError('accepted unsupported program: ' + message)
+
+
+def compile_model(program, stem):
+    pt2 = stem.with_suffix('.pt2')
+    torch.export.save(program, pt2)
+    param, weights = stem.with_suffix('.pnnx.param'), stem.with_suffix('.pnnx.bin')
+    record = frontend.lower(pt2, param, weights)
+    for name, tensor in program.state_dict.items():
+        entry = next(value for value in record['weights'].values() if value['target'] == name)
+        assert entry['sha256'] == hashlib.sha256(tensor.detach().numpy().tobytes()).hexdigest()
+    with zipfile.ZipFile(weights) as archive:
+        assert all(info.compress_type == zipfile.ZIP_STORED for info in archive.infolist())
+        assert sorted(hashlib.sha256(archive.read(name)).hexdigest() for name in archive.namelist()) == sorted(
+            hashlib.sha256(value.detach().numpy().tobytes()).hexdigest() for value in program.state_dict.values())
+    command = [str(pnnx), str(param), 'fp16=0',
+               'pnnxparam=' + str(stem.with_suffix('.converted.param')),
+               'pnnxbin=' + str(stem.with_suffix('.converted.bin')),
+               'ncnnpy=' + str(stem.parent / (stem.name + '_ncnn.py')),
+               'pnnxpy=' + str(stem.with_suffix('.py'))]
+    subprocess.run(command, check=True)
+    generated_spec = importlib.util.spec_from_file_location('generated', stem.with_suffix('.py'))
+    generated = importlib.util.module_from_spec(generated_spec)
+    generated_spec.loader.exec_module(generated)
+    return generated.Model().eval(), pt2, param, weights
+
+
+def test():
+    torch.manual_seed(7)
+    model = Model().eval()
+    x = torch.randn(7, 8)
+    with tempfile.TemporaryDirectory(prefix='pnnx-independent-pt2-') as temporary, torch.no_grad():
+        root = Path(temporary)
+        for candidate, label in ((model, 'swiglu'), (ResidualModel().eval(), 'residual'),
+                                 (AffineNormModel().eval(), 'affine-norm')):
+            for dynamic in (False, True):
+                program = torch.export.export(candidate, (x,), dynamic_shapes=
+                    ({0: torch.export.Dim('tokens', min=1, max=32)},) if dynamic else None)
+                generated, pt2, param, weights = compile_model(program, root / (f'{label}-' + ('dynamic' if dynamic else 'static')))
+                for tokens in ((1, 7, 13, 32) if dynamic else (7,)):
+                    value = torch.randn(tokens, 8)
+                    torch.testing.assert_close(generated(value), candidate(value), rtol=1e-5, atol=1e-6)
+                if dynamic:
+                    for tokens in (0, 33):
+                        reject(lambda: frontend.lower(pt2, param, weights, [[tokens, 8]]),
+                               'positive' if tokens == 0 else 'violates')
+                    reject(lambda: frontend.lower(pt2, param, weights, [[7, 9]]), 'expected 8')
+                    if label == 'swiglu':
+                        # The canonical reader must reject malformed graphs before native passes.
+                        valid = param.read_text()
+                        for bad, message in ((valid.replace('7767517', '1234567', 1), 'magic'),
+                            (valid.replace('nn.Linear', 'aten.unknown', 1), 'unsupported canonical'),
+                            (valid.replace(' 1 1 x ', ' 1 1 missing ', 1), 'unknown input operand'),
+                            (valid.replace('@weight=(16,8)', '@weight=(17,8)', 1), 'weight byte count')):
+                            param.write_text(bad)
+                            result = subprocess.run([str(pnnx), str(param)], text=True, capture_output=True)
+                            assert result.returncode != 0 and message in result.stderr, result.stderr
+                        param.write_text(valid)
+
+        ada = AdaModel().eval()
+        ada_inputs = (x, torch.randn_like(x), torch.randn_like(x))
+        shared = torch.export.Dim('tokens', min=1, max=32)
+        ada_program = torch.export.export(ada, ada_inputs,
+            dynamic_shapes=({0: shared}, {0: shared}, {0: shared}))
+        generated, pt2, param, weights = compile_model(ada_program, root / 'ada')
+        assert 'pnnx.Attribute' in param.read_text()
+        for tokens in (1, 7, 13, 32):
+            values = (torch.randn(tokens, 8), torch.randn(tokens, 8), torch.randn(tokens, 8))
+            torch.testing.assert_close(generated(*values), ada(*values), rtol=1e-5, atol=1e-6)
+        reject(lambda: frontend.lower(pt2, root / 'bad-ada.param', root / 'bad-ada.bin',
+                                       [[7, 8], [13, 8], [7, 8]]), 'shared symbol')
+
+        ada_embedding = AdaEmbeddingModel().eval()
+        embedding_inputs = (x, torch.randn(1, 48))
+        dynamic = torch.export.Dim('tokens', min=1, max=32)
+        embedding_program = torch.export.export(ada_embedding, embedding_inputs,
+            dynamic_shapes=({0: dynamic}, {}))
+        generated, pt2, param, weights = compile_model(embedding_program, root / 'ada-embedding')
+        text = param.read_text()
+        assert 'Tensor.reshape' in text and 'Tensor.slice' in text and 'Tensor.select' in text
+        for tokens in (1, 7, 13, 32):
+            values = (torch.randn(tokens, 8), torch.randn(1, 48))
+            torch.testing.assert_close(generated(*values), ada_embedding(*values), rtol=1e-5, atol=1e-6)
+        assert len([line for line in text.splitlines() if line.startswith('pnnx.Input ')]) == 2
+        assert len([line for line in text.splitlines() if line.startswith('pnnx.Output ')]) == 1
+
+        for boundary in (False, True):
+            attention = AttentionModel(boundary=boundary).eval()
+            inputs = (x, torch.randn(1, 48))
+            program = torch.export.export(attention, inputs)
+            stem = root / ('ada-attention' if boundary else 'attention')
+            generated, pt2, param, weights = compile_model(program, stem)
+            torch.testing.assert_close(generated(*inputs), attention(*inputs), rtol=1e-5, atol=1e-6)
+            text = param.read_text()
+            assert all(op in text for op in ('Tensor.reshape', 'Tensor.select',
+                'nn.RMSNorm', 'Tensor.permute', 'torch.matmul', 'F.scaled_dot_product_attention'))
+            # Tokens are not a batch axis: generated native inputs must retain all 7 rows.
+            native_python = (root / (stem.name + '_ncnn.py')).read_text()
+            assert 'ncnn.Mat(in0.numpy(), batch_index=233)' in native_python, native_python
+            for old, new, message in (('dims=(1,0,2)', 'dims=(0,0,2)', 'invalid Tensor.permute permutation'),
+                                      ('shape=(7,3,2,4)', 'shape=(7,3,2,5)', 'unsupported Tensor.reshape shape')):
+                assert old in text
+                param.write_text(text.replace(old, new, 1))
+                result = subprocess.run([str(pnnx), str(param)], text=True, capture_output=True)
+                assert result.returncode != 0 and message in result.stderr, result.stderr
+            param.write_text(text)
+        for mode in ('mask', 'causal', 'dropout', 'scale', 'gqa'):
+            program = torch.export.export(AttentionModel(mode=mode).eval(), embedding_inputs)
+            path = root / (mode + '.pt2')
+            torch.export.save(program, path)
+            reject(lambda: frontend.lower(path, root / 'bad-attention.param',
+                                          root / 'bad-attention.bin'), 'SDPA')
+            assert not (root / 'bad-attention.param').exists()
+            assert not (root / 'bad-attention.bin').exists()
+
+        class UnsupportedSlice(torch.nn.Module):
+            def forward(self, x, embedding):
+                return x + embedding.reshape(8, 6)[:, ::2].select(1, 0)
+
+        invalid_slice = torch.export.export(UnsupportedSlice(), embedding_inputs,
+            dynamic_shapes=({0: dynamic}, {}))
+        path = root / 'unsupported-slice.pt2'
