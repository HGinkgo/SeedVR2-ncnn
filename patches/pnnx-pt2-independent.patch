+        check(shapes.empty(), "inputshape overrides are unsupported for canonical IR; validate PT2 shapes in the Python frontend");
+        std::ifstream file(path.c_str());
+        check(file.good(), "cannot open IR");
+        std::string line;
+        std::getline(file, line);
+        check(line == "7767517", "invalid IR magic");
+        std::getline(file, line);
+        std::istringstream header(line);
+        int operators = 0, operands = 0;
+        std::string extra;
+        check(bool(header >> operators >> operands) && !(header >> extra) && operators > 0 && operators <= 100000 && operands > 0 && operands <= 100000, "invalid IR counts");
+        pnnx::StoreZipReader archive;
+        check(archive.open(path.substr(0, path.size() - 6) + ".bin") == 0, "cannot open IR weights");
+        std::set<std::string> names, attributes;
+        int inputs = 0, outputs = 0;
+        for (int index = 0; index < operators; index++)
+        {
+            check(bool(std::getline(file, line)), "truncated IR");
+            std::istringstream stream(line);
+            std::string type, name;
+            int ni = 0, no = 0;
+            check(bool(stream >> type >> name >> ni >> no), "invalid operator header");
+            check(names.insert(name).second, "duplicate operator: " + name);
+        check(type == "pnnx.Input" || type == "pnnx.Output" || type == "pnnx.Attribute" || type == "nn.Linear" || type == "nn.RMSNorm" || type == "nn.SiLU" || type == "nn.Conv3d" || type == "nn.GroupNorm" || type == "pnnx.Expression" || type == "Tensor.slice" || type == "Tensor.reshape" || type == "Tensor.select" || type == "Tensor.permute" || type == "Tensor.repeat" || type == "torch.stack" || type == "torch.cat" || type == "torch.index_select" || type == "torch.mean" || type == "torch.matmul" || type == "F.scaled_dot_product_attention" || type == "F.softmax" || type == "F.pad" || type == "torch.clamp", "unsupported canonical IR operator: " + type);
+            check((type == "pnnx.Input" && ni == 0 && no == 1) || (type == "pnnx.Output" && ni == 1 && no == 0) || (type == "pnnx.Attribute" && ni == 0 && no == 1) || (type == "pnnx.Expression" && (ni == 1 || ni == 2) && no == 1) || (type == "torch.matmul" && ni == 2 && no == 1) || (type == "F.scaled_dot_product_attention" && ni == 3 && no == 1) || ((type == "nn.Linear" || type == "nn.RMSNorm" || type == "nn.SiLU" || type == "nn.Conv3d" || type == "nn.GroupNorm" || type == "Tensor.slice" || type == "Tensor.reshape" || type == "Tensor.select" || type == "Tensor.permute" || type == "Tensor.repeat" || type == "F.softmax" || type == "torch.mean" || type == "F.pad" || type == "torch.clamp") && ni == 1 && no == 1) || ((type == "torch.stack" || type == "torch.cat") && ni >= 1 && no == 1) || (type == "torch.index_select" && ni == 2 && no == 1), "invalid operator arity");
