#version 450

layout(binding = 0) readonly buffer input_blob { sfp input_data[]; };
layout(binding = 1) readonly buffer scores_blob { float scores_data[]; };
layout(binding = 2) writeonly buffer output_blob { sfp output_data[]; };
layout(binding = 3) readonly buffer normalizers_blob { float normalizers_data[]; };

layout(push_constant) uniform parameter
{
    int input_cstep;
    int score_cstep;
    int output_cstep;
    int heads;
    int head_dim;
    int window_start;
    int window_length;
} p;

void main()
{
    int feature = int(gl_GlobalInvocationID.x);
    int head = int(gl_GlobalInvocationID.y);
    int query = int(gl_GlobalInvocationID.z);
    if (feature >= p.head_dim || head >= p.heads || query >= p.window_length)
        return;

#if NCNN_bf16_storage || NCNN_bf16_packed || NCNN_fp16_storage || NCNN_fp16_packed
    float value = 0.f;
#else
    precise float value = 0.f;
    precise float correction = 0.f;
#endif
    int score_offset = head * p.score_cstep + query * p.window_length;
    for (int key = 0; key < p.window_length; key++)
    {
        int input_offset = (p.window_start + key) * p.input_cstep +
                           (2 * p.heads + head) * p.head_dim + feature;
#if NCNN_bf16_storage || NCNN_bf16_packed || NCNN_fp16_storage || NCNN_fp16_packed
        value += scores_data[score_offset + key] * float(buffer_ld1(input_data, input_offset));
#else
        precise float product = scores_data[score_offset + key] * float(input_data[input_offset]);
        precise float term = product - correction;
        precise float next = value + term;
        correction = (next - value) - term;
        value = next;
#endif
    }
#if NCNN_bf16_storage || NCNN_bf16_packed
    value /= normalizers_data[head * p.window_length + query];
    uint bits = floatBitsToUint(value);
    value = uintBitsToFloat((bits + 0x7fffu + ((bits >> 16) & 1u)) & 0xffff0000u);
#endif
    int output_offset = (p.window_start + query) * p.output_cstep + head * p.head_dim + feature;
    buffer_st1(output_data, output_offset, afp(value));
}
