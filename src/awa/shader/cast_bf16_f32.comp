#version 450

// BF16 storage/packed buffer -> flat FP32 buffer.
layout(binding = 0) readonly buffer input_blob { sfp input_data[]; };
layout(binding = 1) writeonly buffer output_blob { float output_data[]; };

layout(push_constant) uniform parameter
{
    int total;
    int width;
    int height;
    int depth;
    int channels;
    int batches;
    int input_cstep;
    int input_nstep;
    int output_cstep;
    int output_nstep;
} p;

void main()
{
    int index = int(gl_GlobalInvocationID.x);
    if (index >= p.total)
        return;
    int x = index % p.width;
    int row = index / p.width;
    int y = row % p.height;
    row /= p.height;
    int z = row % p.depth;
    row /= p.depth;
    int channel = row % p.channels;
    int batch = row / p.channels;
    if (batch >= p.batches)
        return;
    int source_offset = batch * p.input_nstep + channel * p.input_cstep +
                        z * p.width * p.height + y * p.width + x;
    int output_offset = batch * p.output_nstep + channel * p.output_cstep +
                        z * p.width * p.height + y * p.width + x;
    output_data[output_offset] = float(buffer_ld1(input_data, source_offset));
}
