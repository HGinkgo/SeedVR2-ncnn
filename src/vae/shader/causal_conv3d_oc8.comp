#version 450

layout(binding = 0) readonly buffer bottom_blob { sfp bottom_blob_data[]; };
layout(binding = 1) writeonly buffer top_blob { sfp top_blob_data[]; };
layout(binding = 2) readonly buffer weight_blob { sfp weight_data[]; };
layout(binding = 3) readonly buffer bias_blob { sfp bias_data[]; };

layout(push_constant) uniform parameter
{
    int input_w; int input_h; int input_d; int input_c; int input_cstep;
    int output_w; int output_h; int output_d; int output_cstep;
    int kernel_w; int kernel_h; int kernel_d;
    int dilation_w; int dilation_h; int dilation_d;
    int stride_w; int stride_h; int stride_d;
    int pad_w_before; int pad_w_after; int pad_h_before; int pad_h_after;
    int pad_d_before; int pad_d_after; int prepend; float pad_value;
    int num_output; int bias_term; int activation_type;
    float activation_param_0; float activation_param_1;
} p;

void main()
{
    const int output_x = int(gl_GlobalInvocationID.x);
    const int output_y_depth = int(gl_GlobalInvocationID.y);
    const int output_channel_base = int(gl_GlobalInvocationID.z) * 8;
    if (output_x >= p.output_w || output_y_depth >= p.output_h * p.output_d ||
        output_channel_base >= p.num_output)
        return;

    const int output_depth = output_y_depth / p.output_h;
    const int output_y = output_y_depth % p.output_h;
    const int output_plane = p.output_w * p.output_h;
    const int spatial_index = output_depth * output_plane + output_y * p.output_w + output_x;
    afp sum0 = p.bias_term == 1 ? buffer_ld1(bias_data, output_channel_base) : afp(0.f);
    afp sum1 = p.bias_term == 1 ? buffer_ld1(bias_data, output_channel_base + 1) : afp(0.f);
    afp sum2 = p.bias_term == 1 ? buffer_ld1(bias_data, output_channel_base + 2) : afp(0.f);
    afp sum3 = p.bias_term == 1 ? buffer_ld1(bias_data, output_channel_base + 3) : afp(0.f);
    afp sum4 = p.bias_term == 1 ? buffer_ld1(bias_data, output_channel_base + 4) : afp(0.f);
    afp sum5 = p.bias_term == 1 ? buffer_ld1(bias_data, output_channel_base + 5) : afp(0.f);
    afp sum6 = p.bias_term == 1 ? buffer_ld1(bias_data, output_channel_base + 6) : afp(0.f);
    afp sum7 = p.bias_term == 1 ? buffer_ld1(bias_data, output_channel_base + 7) : afp(0.f);

    for (int input_channel = 0; input_channel < p.input_c; input_channel++)
    {
        const int input_weight_offset = input_channel * 27;
        const int weight_offset0 = output_channel_base * p.input_c * 27 + input_weight_offset;
        const int weight_offset1 = (output_channel_base + 1) * p.input_c * 27 + input_weight_offset;
        const int weight_offset2 = (output_channel_base + 2) * p.input_c * 27 + input_weight_offset;
        const int weight_offset3 = (output_channel_base + 3) * p.input_c * 27 + input_weight_offset;
        const int weight_offset4 = (output_channel_base + 4) * p.input_c * 27 + input_weight_offset;
        const int weight_offset5 = (output_channel_base + 5) * p.input_c * 27 + input_weight_offset;
        const int weight_offset6 = (output_channel_base + 6) * p.input_c * 27 + input_weight_offset;
        const int weight_offset7 = (output_channel_base + 7) * p.input_c * 27 + input_weight_offset;
        for (int kernel_depth = 0; kernel_depth < 3; kernel_depth++)
        {
            const int source_depth = max(output_depth + kernel_depth - p.prepend, 0);
            for (int kernel_y = 0; kernel_y < 3; kernel_y++)
            {
                const int input_y = output_y + kernel_y - 1;
                for (int kernel_x = 0; kernel_x < 3; kernel_x++)
                {
                    const int input_x = output_x + kernel_x - 1;
                    afp value = afp(0.f);
                    if (input_y >= 0 && input_y < p.input_h && input_x >= 0 && input_x < p.input_w)
                    {
                        const int input_offset = input_channel * p.input_cstep +
                                                 source_depth * p.input_w * p.input_h +
                                                 input_y * p.input_w + input_x;
                        value = buffer_ld1(bottom_blob_data, input_offset);
                    }
                    const int kernel_offset = (kernel_depth * 3 + kernel_y) * 3 + kernel_x;
                    sum0 += value * buffer_ld1(weight_data, weight_offset0 + kernel_offset);
                    sum1 += value * buffer_ld1(weight_data, weight_offset1 + kernel_offset);
                    sum2 += value * buffer_ld1(weight_data, weight_offset2 + kernel_offset);
                    sum3 += value * buffer_ld1(weight_data, weight_offset3 + kernel_offset);
                    sum4 += value * buffer_ld1(weight_data, weight_offset4 + kernel_offset);
                    sum5 += value * buffer_ld1(weight_data, weight_offset5 + kernel_offset);
                    sum6 += value * buffer_ld1(weight_data, weight_offset6 + kernel_offset);
                    sum7 += value * buffer_ld1(weight_data, weight_offset7 + kernel_offset);
                }
            }
        }
    }

    buffer_st1(top_blob_data, output_channel_base * p.output_cstep + spatial_index, sum0);
    buffer_st1(top_blob_data, (output_channel_base + 1) * p.output_cstep + spatial_index, sum1);
    buffer_st1(top_blob_data, (output_channel_base + 2) * p.output_cstep + spatial_index, sum2);
    buffer_st1(top_blob_data, (output_channel_base + 3) * p.output_cstep + spatial_index, sum3);
    buffer_st1(top_blob_data, (output_channel_base + 4) * p.output_cstep + spatial_index, sum4);
    buffer_st1(top_blob_data, (output_channel_base + 5) * p.output_cstep + spatial_index, sum5);
    buffer_st1(top_blob_data, (output_channel_base + 6) * p.output_cstep + spatial_index, sum6);
    buffer_st1(top_blob_data, (output_channel_base + 7) * p.output_cstep + spatial_index, sum7);
}
